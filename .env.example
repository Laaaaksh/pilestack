# Copy this file to .env and fill in real values.
# See CONTRIBUTING.md and README.md#configuration for how to obtain each one.

# SQLite by default — this is the only line most self-hosters need to touch.
DATABASE_URL="file:../data/pilestack.db"

# --- GitHub App (the "Pilestack" app installed on your org/repos) ---
# Create one at https://github.com/settings/apps/new — see README.md#install.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY_PATH="./data/github-app-private-key.pem"
GITHUB_WEBHOOK_SECRET=""

# --- GitHub OAuth (lets teammates sign in to the dashboard) ---
# A separate OAuth App at https://github.com/settings/applications/new,
# callback URL "<NEXTAUTH_URL>/api/auth/callback/github".
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# --- NextAuth ---
# Generate with: openssl rand -base64 33
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
